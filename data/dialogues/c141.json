    {"role": "A", "text": "Wit, bruin of volkoren?", "translation": "White, brown or wholemeal?"},
    {"role": "B", "text": "Een volkorenbrood, alstublieft.", "translation": "A wholemeal loaf, please."},
    {"role": "A", "text": "Wilt u het gesneden hebben?", "translation": "Would you like it sliced?"},
    {"role": "B", "text": "Ja, graag.", "translation": "Yes, please."},
    {"role": "A", "text": "Is dit alles?", "translation": "Is this everything?"},
    {"role": "B", "text": "Dat was alles. Hoeveel kost het?", "translation": "That's all. How much is it?"},
    {"role": "A", "text": "€3,50. Alstublieft.", "translation": "€3.50. Here you go."},
    {"role": "B", "text": "Alsjeblieft. Fijne dag.", "translation": "Here you go. Have a nice day."},
